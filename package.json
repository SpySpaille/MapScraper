{
  "name": "mapscraper",
  "version": "1.8",
  "description": "Source Engine content scraper for VMF maps",
  "main": "main.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/test_parsers.js",
    "build": "pkg . --targets node18-win-x64 -C Brotli --output dist/MapScraper.exe"
  },
  "author": "SpySpaille",
  "license": "ISC",
  "dependencies": {
    "@colors/colors": "^1.5.0",
    "figlet": "^1.5.2",
    "fs-extra": "^11.1.0",
    "node-fetch": "^2.6.1",
    "prompt": "^1.3.0",
    "source-mdl": "^0.2.4"
  },
  "bin": "./main.js",
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "node_modules/figlet/fonts/Standard.flf",
      "Getters/*.txt"
    ]
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
